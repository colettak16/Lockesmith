let studentList = [];

function quizCheck() {
  let urlPath = window.location.pathname;
  let quizPattern = /^\/courses\/\d*\/quizzes\/\d*\/edit$/;
  return quizPattern.test(urlPath);
}

function getCourseId() {
  let urlPath = window.location.pathname;
  let courseIdPattern = /^\/courses\/(\d*)\//;
  let courseId = courseIdPattern.exec(urlPath);
  return courseId[1];
}

async function adminCheck() {
  const admins = [6, 228428, 364986];
  const userId = await getUserId();
  return admins.includes(userId);
}

function userUrl() {
  return '/api/v1/users/self';
}

async function getUserId() {
  const url = userUrl();
  const res = await fetch(url);
  const data = await res.json();
  return data.id;
}

async function tests() {
  let qCheck = quizCheck();
  let aCheck = adminCheck();
  return !!(qCheck && aCheck);
}

async function checkEnrollments() {
  let courseId = getCourseId();
  let url = '/api/v1/courses/' + courseId + '/enrollments?role_id[]=171&per_page=100';
  const response = await fetch(url);
  const data = await response.json();
  if (data.length > 0) {
    await checkCustomData(data);
  }
}

async function checkCustomData(students) {
  for (let i = students.length - 1; i >= 0; i--) {
    let url = '/api/v1/users/' + students[i].user.id + '/custom_data?ns=edu.columbia.courseworks2';
    try {
      const response = await fetch(url);
      if (response.status === 200) {
        students[i].customData = await response.json();
      } else {
        // If response status is not 200, handle the error gracefully.
        console.error('Failed to fetch custom data for user:', students[i].user.id);
      }
    } catch (error) {
      console.error('Error fetching custom data:', error);
    }
  }
  for (let z = 0; z < students.length; z++) {
    if (students[z].customData && students[z].customData.data.quiz.quiz_check === '*') {
      studentList.push(students[z].user.name);
    }
  }
  checkList();
}

window.addEventListener("load", async () => {
  if (await tests()) {
    checkEnrollments();
    const assignedTo = document.getElementById('overrides-wrapper');
    let mutationConfig = { subtree: true, childList: true };
    let studentListCallback = (mutationList) => {
      for (let mutation of mutationList) {
        if (mutation.type === 'childList') {
          checkList();
        }
      }
    };
    let observer = new MutationObserver(studentListCallback);
    observer.observe(assignedTo, mutationConfig);
  }
});

function checkList() {
  let tokens = document.getElementsByClassName("ic-token-label");
  for (let n = 0; n < tokens.length; n++) {
    tokens[n].style.backgroundColor = '#f5f5f5';
    if (studentList.includes(tokens[n].innerHTML)) {
      tokens[n].style.backgroundColor = "lightblue";
    }
  }
}
