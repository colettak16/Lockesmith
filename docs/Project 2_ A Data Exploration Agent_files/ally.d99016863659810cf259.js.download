nt to make sure we\'re not overriding any other display rules that might be set by\n       more specific rules applied by the client.\n       In table layouts, highlighted inline-block content can overflow into adjacent cells when link text is long.\n       These wrapping constraints keep highlighted content contained within its own cell. */\n    display: inline-block;\n    box-decoration-break: clone !important;\n    line-height: calc(100% + 12px) !important;\n    max-width: 100%;\n    overflow-wrap: anywhere;\n    word-break: break-word;\n    padding-left: 2px;\n    padding-right: 2px;\n    position: relative !important;\n    white-space: normal;\n}\n\na[data-ally-html-preview-highlight] {\n    max-width: calc(100% - 13px);\n}\n\n/* Prevent highlighted text in table cells from overflowing into adjacent cells.\n   Selector matches HtmlPreviewDriver.previewRootClassName in HtmlPreviewDriver.ts — update both if the class name changes. */\n.ally-html-preview-content table td,\n.ally-html-preview-content table th {\n    overflow-wrap: anywhere;\n    word-break: break-word;\n    white-space: normal;\n    vertical-align: top;\n}\n\n.ally-html-preview-content table {\n    table-layout: fixed;\n    width: 100%;\n}\n\n[data-ally-html-preview-highlight-shadow] {\n    position: relative;\n    box-sizing: border-box;\n    width: fit-content;\n    height: fit-content;\n}\n\n[data-ally-html-preview-highlight-shadow]::before {\n    content: "";\n    position: absolute;\n    top: -6px;\n    left: -6px;\n    right: -6px;\n    bottom: -6px;\n    background:\n        repeating-linear-gradient(\n            -45deg,\n            #AF0216,\n            #AF0216 3px,\n            #FF919E 2px,\n            #FF919E 5px\n        );\n    z-index: -1;\n}\n\n[data-ally-html-preview-highlight],\n[data-ally-html-preview-outline-inset]::after,\n[data-ally-html-preview-outline-outset]::after {\n    border: double 6px #AF0216 !important;\n    border-image:\n        repeating-linear-gradient(\n       